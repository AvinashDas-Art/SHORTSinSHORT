# --- Server-side only (set these in Vercel > Settings > Environment Variables, never in this file) ---
# PayU merchant credentials, used by api/payu-webhook.js and api/admin-reconcile-payment.js
PAYU_KEY=
PAYU_SALT=
# "production" (default) or "test" — which PayU verify_payment host to call
PAYU_ENV=production

# Firebase Admin SDK service account, used server-side to write membership records
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# A random secret only you know, required to call api/admin-reconcile-payment.js
ADMIN_RECONCILE_SECRET=
